[Unit]
Description=Incremental rebuild of the habitat context DB from the live vaults (desktop twin, R-095)

[Service]
Type=oneshot
ExecStart=%h/.local/share/turso/context/bin/habitat-context-refresh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=60min
# Sandboxing (2026-10-07): root filesystem read-only, writes limited to what the job needs.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=%h/.local/share/turso/context %h/.cache
