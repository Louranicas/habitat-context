"""


def live_probe(c, timeout=4):
    """One read-only ssh probe (script on stdin, never a nested -c string). Cache it; fall back to the cache."""
    import subprocess
    try:
        cmd = ["bash", "-s"] if ON_DESKTOP else ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3",
                                                  os.environ.get("HABITAT_HOST", "desktop-native-tail"), "bash", "-s"]
        r = subprocess.run(cmd,
                           input=PROBE, capture_output=True, text=True, timeout=timeout)
        data = json.loads(r.stdout.strip().splitlines()[-1])
        data["at"] = time.strftime("%H:%M")
        r = rcon()
        r.execute("insert or replace into cache values('live_probe', ?)", (json.dumps(data),))
        r.commit()
        return data, "live"
    except Exception:
        row = rcon().execute("select value from cache where key='live_probe'").fetchone()
        return (json.loads(row[0]), "cached") if row else (None, "unavailable")


def brief():
    try:
        c = con()
    except RuntimeError as e:
        print(f"# Habitat context: the context DB is busy ({e}). Read herdr.habitat.vault/00 Start/Quick context protocol.md "
              "and run `habitat-ctx brief` again shortly. State is a query: check live before acting.")
        return
    built = dict(c.execute("select key, value from meta").fetchall())
    n, e = c.execute("select count(*), count(emb) from sections").fetchone()
    led = os.path.join(SNAP, "herdr.habitat.vault/50 Ledger/Recommendations ledger.md")
    status = {}
    if os.path.exists(led):
        for line in open(led, errors="replace"):
            m = re.match(r"^\| (R-\d+) \| .*? \| ([^|]+?) \| ", line)
            if m:
                st = m.group(2).strip().split(" (")[0].split(":")[0]
                status[st] = status.get(st, 0) + 1
    held = [l.split("|")[1].strip() for l in open(led, errors="replace")
            if l.startswith("| R-") and "held for Luke" in l] if os.path.exists(led) else []
    stale = ""
    try:
        snap_t = time.mktime(time.strptime(built.get("snapshot", ""), "%Y%m%dT%H%M%SZ")) - time.timezone
        age_h = (time.time() - snap_t) / 3600
        if age_h > 26:
            stale = f" STALE: the snapshot is {age_h:.0f} h old; run `habitat-ctx refresh`."
    except Exception:
        pass
    lines = [
        "# Habitat context: Quick context protocol v1 (herdr.habitat.vault/00 Start/Quick context protocol.md)",
        f"Context DB built {built.get('built_at','?')} from off-site snapshot {built.get('snapshot','?')}: "
        f"{n} sections, {e} embedded.{stale} This card is a pointer; state is a query, so re-check live before acting.",
        ("WHERE: you are ON the Canberra desktop (the habitat itself); vaults at /mnt/storage-10tb/fedora-obsidian-vaults."
         if ON_DESKTOP else
         "WHERE: the habitat runs on the Canberra desktop (ssh desktop-native-tail); this laptop holds the off-site copy."),
        "1 ORIENT, stopping when covered: facet summaries (70 Facets) via `habitat-ctx ask`; Home and session state; "
        "the handoff and ledger; then the project entry (HEE: START.md, context-doctor, hee4db recipe restart).",
        "2 RETRIEVE by lawful judge: grep or hee4db first; `habitat-ctx ask` (FTS and embeddings, works on facets and v4); "
        "local BAML YES/NO for close calls (set num_ctx); Jev only for the boundary-cleared corpus. "
        "Ask existence first, separate questions; read the top 4 (>=70% hit) or top 5 (>=80%; conformal, held-out n=40); `--judge` re-checks the top 5 locally (+2 in the top 3 on v3, ~4 s). Log skips. "
        "No v4 text to Jev, not even a summary.",
        "3 ACT SAFELY: engine work in a desktop session in the repo (a refusal means the wrong place, don't route around it). "
        "Use quoted `bash -s` heredocs; no nested bash -c; never pkill -f. Plant a failing control before trusting a green. "
        "v3 fenced; single DB writers; commit only when asked; gate before commit. Verify gate files after installs.",
        "4 LEAVE IT BETTER: update the owning note and a dated ledger line; lessons to their one home (facet 11).",
        f"Ledger: {', '.join(f'{v} {k}' for k, v in sorted(status.items(), key=lambda x: -x[1])[:5])}. "
        f"Held for Luke: {', '.join(held[:12])}.",
    ]
    lp, how = live_probe(c)
    if lp:
        lines.append(f"LIVE ({how} {lp.get('at','?')}): jev door {lp['jev_door']}; hee4 {lp['hee4']} at {lp['hee4_head']} "
                     f"with {lp['hee4_dirty']} uncommitted files; lavish-guard {lp['lavish'] or '?'}; "
                     f"failing units: {lp['failed_units'].strip() or 'none'}.")
    else:
        lines.append("LIVE: desktop unreachable and no cached probe; check `ssh desktop-native-tail` before acting.")
    text = "\n".join(lines)
    print(text)
    receipt(c, "brief", "", text, [])


def stats():
    c = con()
    print(dict(c.execute("select key, value from meta").fetchall()))
    for v, n, e, j in c.execute("select vault, count(*), count(emb), sum(jev_ok) from sections group by vault order by 2 desc"):
        print(f"  {v:38s} sections={n:6d} embedded={e:6d} jev_ok={j}")
    print("receipts:", rcon().execute("select kind, count(*) from prime_receipts group by kind").fetchall())


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a or a[0] == "brief":
        brief()
    elif a[0] == "ask" and len(a) > 1:
        k = int(a[a.index("-k") + 1]) if "-k" in a else 5
        scope = a[a.index("--scope") + 1] if "--scope" in a else None
        ask(a[1], k, "--jev-only" in a, scope, "--judge" in a)
    elif a[0] == "stats":
        stats()
    elif a[0] == "label" and len(a) > 2:  # grow the eval set from real use: which note actually answered
        r = rcon()
        r.execute("create table if not exists labels(id integer primary key, ts text, question text, gold text, origin text)")
        r.execute("insert into labels(ts,question,gold,origin) values(?,?,?,?)",
                  (time.strftime("%Y-%m-%dT%H:%M:%S%z"), a[1], a[2], os.environ.get("HABITAT_CTX_ORIGIN", "session")))
        r.commit()
        print(f"labelled: {a[2]}")
    elif a[0] == "refresh":  # off-site pull, then the chained incremental context rebuild
        import subprocess
        sys.exit(subprocess.run(["systemctl", "--user", "start", "habitat-offsite-pull.service"]).returncode)
    else:
        print(__doc__)
        sys.exit(2)
