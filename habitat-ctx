"""habitat-ctx — curated habitat context from the Turso context DB (prime packets with receipts).

  habitat-ctx brief            startup card (<= ~2 KB): orientation, open blockers, where to look
  habitat-ctx ask "<question>" [-k 5] [--jev-only] [--scope "70 Facets"] [--judge]
                               hybrid retrieval: Turso FTS (BM25) + section embeddings (cosine),
                               fused by reciprocal rank; prints path#heading, score and jev_ok
  habitat-ctx stats            what the DB holds and when it was built
  habitat-ctx refresh          off-site pull now, then the chained incremental context rebuild
  habitat-ctx label "<question>" "<vault/path.md>"   record which note answered (feeds tests/eval_heldout.py --with-labels)

Embedding the question needs the desktop's ollama via `ssh -L 11435:127.0.0.1:11434
desktop-native-tail`. Without it, ask degrades to FTS only and says so. Every brief and ask writes a
receipt (prime_receipts) so what an agent was shown is auditable. Read-only toward everything else.
"""
import hashlib, json, os, re, sys, time, urllib.request

import turso

DB = os.environ.get("HABITAT_CTX_DB", os.path.expanduser("~/.local/share/turso/context/habitat-context.db"))
# Host-aware: both machines are named 'omarchy'; the desktop is the one with the 10 TB vault root.
ON_DESKTOP = os.path.isdir("/mnt/storage-10tb/fedora-obsidian-vaults")
_OLLAMA = "http://127.0.0.1:11434" if ON_DESKTOP else "http://127.0.0.1:11435"
EMB = os.environ.get("HABITAT_CTX_EMB_URL", _OLLAMA + "/v1/embeddings")
ABSTAIN_DIST = float(os.environ.get("HABITAT_CTX_ABSTAIN", "0.53"))  # provisional: 2026-10-06, n=22, on-topic max 0.499, off-topic min 0.562 (facets)
FTS_WEIGHT = float(os.environ.get("HABITAT_CTX_FTS_W", "0.5"))  # measured 2026-10-06: OR-of-words FTS is noisier than embeddings; half weight in the fusion
SNAP = "/mnt/storage-10tb/fedora-obsidian-vaults" if os.path.isdir("/mnt/storage-10tb/fedora-obsidian-vaults") \
    else os.path.expanduser("~/Backups/herdr-habitat-offsite/snap/latest/vaults")
RRF_K = 60


def con():
    """Context DB: READ ONLY by convention (pyturso has no read-only mode). Only build_context.py writes,
    and only to an unpublished copy that is atomically renamed into place."""
    if not os.path.exists(DB):  # never create an empty DB from a startup hook
        sys.exit(0)
    return _open_retry(DB, experimental_features="index_method")


def _open_retry(path, **kw):
    """pyturso 0.8.1 locks a DB file exclusively per process, even for readers (MEASURED 2026-10-06).
    Retry briefly so concurrent sessions queue instead of failing."""
    delay = 0.05
    for _ in range(12):  # about 3 s in total
        try:
            return turso.connect(path, **kw)
        except Exception as e:
            if "lock" not in str(e).lower():
                raise
            time.sleep(delay)
            delay = min(delay * 1.6, 0.5)
    raise RuntimeError(f"{os.path.basename(path)} busy (locked by another process)")


RDB = os.environ.get("HABITAT_CTX_RECEIPTS", os.path.expanduser("~/.local/share/turso/context/receipts.db"))  # real home, independent of HABITAT_CTX_DB


def rcon():
    """Receipts and the live-probe cache: habitat-ctx is this file's single writer."""
    c = _open_retry(RDB)
    c.execute("create table if not exists prime_receipts(id integer primary key, ts text, kind text,"
              " query text, packet_sha text, items text, origin text)")
    c.execute("create table if not exists cache(key text primary key, value text)")
    c.commit()
    return c


def receipt(_c, kind, query, text, items):
    """Who saw what: origin is HABITAT_CTX_ORIGIN (e.g. 'eval', 'dev') or 'session' for real use."""
    c = rcon()
    c.execute("insert into prime_receipts(ts,kind,query,packet_sha,items,origin) values(?,?,?,?,?,?)",
              (time.strftime("%Y-%m-%dT%H:%M:%S%z"), kind, query,
               hashlib.sha256(text.encode()).hexdigest()[:16], json.dumps(items),
               os.environ.get("HABITAT_CTX_ORIGIN", "session")))
    c.commit()


def _embed_at(url, q):
    body = {"model": "qwen3-embedding:0.6b",
            "input": ["Instruct: Given a question, retrieve the habitat note section that answers it\nQuery: " + q]}
    req = urllib.request.Request(url, json.dumps(body).encode(), {"Content-Type": "application/json"})
    return json.load(urllib.request.urlopen(req, timeout=20))["data"][0]["embedding"]


def embed(q):
    """Use the configured endpoint; if it is down, open a short-lived ssh -L to the desktop's ollama
    (compute only), embed, and close it by its own process handle (never by pattern)."""
    try:
        return _embed_at(EMB, q)
    except Exception:
        if os.environ.get("HABITAT_CTX_NO_TUNNEL") or ON_DESKTOP:
            raise
    import socket, subprocess
    s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close()
    tun = subprocess.Popen(["ssh", "-N", "-o", "BatchMode=yes", "-o", "ExitOnForwardFailure=yes", "-o", "ConnectTimeout=5",
                            "-L", f"{port}:127.0.0.1:11434", "desktop-native-tail"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        for _ in range(40):
            try:
                return _embed_at(f"http://127.0.0.1:{port}/v1/embeddings", q)
            except Exception:
                if tun.poll() is not None:
                    raise
                time.sleep(0.25)
        raise TimeoutError("embedding tunnel did not come up")
    finally:
        tun.terminate()
        try:
            tun.wait(timeout=3)
        except Exception:
            tun.kill()


CHAT = os.environ.get("HABITAT_CTX_CHAT_URL", _OLLAMA + "/v1/chat/completions")
JUDGE_MODEL = os.environ.get("HABITAT_CTX_JUDGE", "gemma4:12b")
# Split-conformal read-set sizes from the independent held-out set (n=40, index v3, 2026-10-06).
# Recompute whenever the index or ranking changes.
READ_K = {"70%": 4, "80%": 5}


def p_yes(question, text):
    """Local YES/NO judge: P(YES) from the answer token's log-probability (reasoning off). Text is capped
    so the prompt stays under Ollama /v1's silent ~2k-token truncation."""
    import math
    body = {"model": JUDGE_MODEL, "temperature": 0, "max_tokens": 2, "logprobs": True, "top_logprobs": 5,
            "reasoning_effort": "none",
            "messages": [{"role": "user", "content": f"Question: {question}\n\nNote section:\n{text[:1800]}\n\n"
                          "Does this note section directly answer the question? Reply with exactly one word: YES or NO."}]}
    req = urllib.request.Request(CHAT, json.dumps(body).encode(), {"Content-Type": "application/json"})
    tok = json.load(urllib.request.urlopen(req, timeout=120))["choices"][0]["logprobs"]["content"][0]
    p, w = math.exp(tok["logprob"]), tok["token"].strip().upper()
    return p if w.startswith("Y") else (1 - p if w.startswith("N") else 0.5)


def fts_terms(q):
    # Prefix '*' silently returns nothing on this engine; quote plain words only.
    words = [w for w in re.findall(r"[A-Za-z0-9][A-Za-z0-9_-]{2,}", q.lower())
             if w not in {"the", "and", "what", "how", "does", "where", "which", "should", "with", "for", "are", "can"}]
    return " ".join(words)


def ask(question, k=5, jev_only=False, scope=None, judge=False):
    c = con()
    where = " and jev_ok=1" if jev_only else ""
    params_scope = ()
    if scope:
        where += " and path like ?"
        params_scope = (f"%{scope}%",)
    ranks = {}
    terms = fts_terms(question)
    if terms:
        # fts_score is 0.0 for a bound parameter on tursodb 0.8.1 (MEASURED 2026-10-06): the query text
        # must be a literal. fts_terms() emits only [A-Za-z0-9_-] words; quotes are escaped as a second guard.
        lit = "'" + terms.replace("'", "''") + "'"
        try:
            # fts_score also reads 0.0 when any other predicate shares the WHERE (MEASURED): query bare,
            # then apply scope and jev filters in Python.
            # the builder records the FTS index's columns; never infer them from a version number
            cols = (c.execute("select value from meta where key='fts_cols'").fetchone() or ["body"])[0]
            rows = c.execute(f"select id, fts_score({cols}, {lit}) s from sections where fts_match({cols}, {lit})"
                             f" order by s desc limit 400").fetchall()
            keep = []
            for i, _ in rows:
                if where:
                    path, jev = c.execute("select path, jev_ok from sections where id=?", (i,)).fetchone()
                    if scope and scope not in path:
                        continue
                    if jev_only and not jev:
                        continue
                keep.append(i)
                if len(keep) >= 60:
                    break
            for r, i in enumerate(keep):
                ranks.setdefault(i, {})["fts"] = r + 1
        except Exception as e:
            print(f"(fts unavailable: {e})", file=sys.stderr)
    mode = "hybrid"
    try:
        v = json.dumps(embed(question))
        rows = c.execute(f"select id, vector_distance_cos(emb, vector32(?)) d from sections"
                         f" where emb is not null{where} order by d limit 60", (v,) + params_scope).fetchall()
        for r, (i, _) in enumerate(rows):
            ranks.setdefault(i, {})["vec"] = r + 1
        top1 = rows[0][1] if rows else 1.0
        top2 = [d for _, d in rows[:2]]
        margin = (top2[1] - top2[0]) if len(top2) == 2 else 0.0
    except Exception:
        mode, margin, top1 = "fts-only (embedding tunnel down)", None, None
    w = {"fts": FTS_WEIGHT, "vec": 1.0}
    scored = sorted(ranks.items(), key=lambda kv: -sum(w[s] / (RRF_K + r) for s, r in kv[1].items()))
    out, items, seen = [], [], set()
    for i, how in scored:  # one best section per note
        vault, path, head, jev = c.execute("select vault, path, heading, jev_ok from sections where id=?", (i,)).fetchone()
        if path in seen:
            continue
        seen.add(path)
        score = sum(w[s] / (RRF_K + r) for s, r in how.items())
        out.append(f"{score:.4f}  {path}#{head[:60]}  [{'+'.join(sorted(how))}] jev_ok={jev}")
        items.append({"id": i, "path": path, "heading": head})
        if len(out) >= k:
            break
    if judge and items:
        bodies = [c.execute("select body from sections where id=?", (it["id"],)).fetchone()[0] for it in items[:5]]
        try:
            scores = [p_yes(question, b) for b in bodies]
            order = sorted(range(len(scores)), key=lambda i: -scores[i])
            out = [f"P(yes)={scores[i]:.2f}  " + out[i] for i in order] + out[5:]
            items = [items[i] for i in order] + items[5:]
            mode += f" + {JUDGE_MODEL} judge"
            if max(scores) < 0.5:
                mode += "  ABSTAIN (judge: no top-5 section answers this)"
        except Exception as e:
            mode += f" (judge unavailable: {type(e).__name__})"
    conf = "" if margin is None else (f"  top1_dist={top1:.3f} margin={margin:.3f}"
                                      + (f"  ABSTAIN: nothing close (dist>{ABSTAIN_DIST})" if top1 > ABSTAIN_DIST
                                         else f"  read top {READ_K['70%']} (>=70%) · top {READ_K['80%']} (>=80%)"))
    text = f"habitat-ctx ask ({mode}){conf}\n" + "\n".join(out)
    print(text)
    receipt(c, "ask", question, text, items)

